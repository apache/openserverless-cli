# Exclusions for Apache RAT (used together with --input-exclude-parsed-scm GIT).
# Kept in sync with the paths-ignore section of .licenserc.yaml.

# Vendored third-party test frameworks, cloned by the "bats" task.
# Not part of the source release; each carries its own license.
tests/bats/**
tests/test_helper/**

# Build/tooling artifacts and downloaded binaries.
.task/**
.vscode/**
tests/_bin/**

# Generated files.
go.sum

# Data files parsed verbatim by the code or asserted on by the tests:
# a license header would corrupt their contents.
**/*.txt
**/*.json
